{
  "name": "threejs-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Professional Three.js / WebGPU boilerplate — TypeScript strict, Vite 6, GPU dispose pattern",
  "author": "NgQuan",
  "scripts": {
    "// dev": "Chạy môi trường phát triển",
    "dev": "vite",
    "// build": "Kiểm tra lỗi và đóng gói sản phẩm",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "// quality": "Kiểm tra lỗi logic và định dạng code",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"src/**/*.{ts,js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,css,html}\"",
    "// test": "Chạy các bài kiểm tra",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "type-check": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/stats.js": "^0.17.4",
    "@types/three": "^0.174.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/ui": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.0.0",
    "stats.js": "^0.17.0",
    "tweakpane": "^4.0.5",
    "typescript": "^5.0.0",
    "vite": "^6.2.2",
    "vite-plugin-checker": "^0.13.0",
    "vite-plugin-restart": "^0.4.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "three": "^0.174.0"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.ts": [
      "bash -c 'tsc --noEmit'"
    ]
  }
}
