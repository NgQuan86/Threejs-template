# ─── Hồ sơ mẫu ─────────────────────────────────────────────────────────────
# Sao chép file này thành `.env` và điền các giá trị thực
# KHÔNG commit file `.env` lên Git!
# cp .env.example .env

# ─── Ứng dụng ───────────────────────────────────────────────────────────────
VITE_APP_TITLE="Three.js Journey"
VITE_APP_VERSION="0.0.0"

# ─── Môi trường ─────────────────────────────────────────────────────────────
# development | production | staging
VITE_ENV=development

# ─── Debug & Dev Tools ──────────────────────────────────────────────────────
# Hiện Stats.js FPS counter (true/false)
VITE_SHOW_STATS=true

# Hiện Leva GUI controls (true/false)
VITE_SHOW_DEBUG=true

# ─── Performance ────────────────────────────────────────────────────────────
# Giới hạn Pixel Ratio (1 | 2 | null = auto)
VITE_MAX_PIXEL_RATIO=2

# ─── API Keys (nếu dùng external services) ──────────────────────────────────
# VITE_MAPBOX_TOKEN=your_token_here
# VITE_SUPABASE_URL=your_url_here
# VITE_SUPABASE_ANON_KEY=your_key_here
